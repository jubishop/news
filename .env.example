# Production values live in /etc/news/app.env, mode 0600.
NEWS_DATABASE=var/news.sqlite3
NEWS_SECRET_KEY=
NEWS_BASE_URL=https://news.jubishop.com
NEWS_ACCESS_ISSUER=https://jubishop.cloudflareaccess.com
NEWS_OWNER_AUD=
NEWS_WORKER_AUD=
NEWS_OWNER_EMAIL=
NEWS_WORKER_ID=local
# Enable when the real research worker is commissioned.
NEWS_MONITOR_WORKER=false
NEWS_MONITOR_START_DATE=
NEWS_BACKUP_STATE=/var/lib/news-backup/size.json
NEWS_EMAIL_FROM="News <news@jubishop.com>"
NEWS_ALERT_TO=
RESEND_API_KEY=
