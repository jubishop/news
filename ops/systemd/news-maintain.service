[Unit]
Description=News schedule checks, Trash cleanup, and queued email
After=news.service

[Service]
Type=oneshot
User=news
Group=news
WorkingDirectory=/opt/news/current
EnvironmentFile=/etc/news/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/opt/news/current/.venv/bin/python -m news.cli maintain
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/news
MemoryMax=128M
CPUQuota=50%
TimeoutStartSec=10min
