[Unit]
Description=News public edition and owner newsroom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=news
Group=news
WorkingDirectory=/opt/news/current
EnvironmentFile=/etc/news/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/news/current/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:3070 --timeout 30 --access-logfile /dev/null --error-logfile - 'news:create_app()'
Restart=on-failure
RestartSec=5
StateDirectory=news news-backup
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/news
MemoryMax=256M
CPUQuota=75%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
