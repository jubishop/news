#!/bin/sh
# Run News application checks; bin/check --full calls this after the foundation checks.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
.venv/bin/python -B -c 'import news'
.venv/bin/python -B -m unittest discover -s tests/app -v
.venv/bin/python -B tests/test_browser.py
shellcheck --shell=sh ops/install-server ops/deploy-main ops/install-worker bin/worker
