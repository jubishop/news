#!/usr/bin/env python3
"""Report whether a validated workflow run should deploy production.

For a pull request, fail when its head commit has News-Deploy lines that Git
doesn't read as trailers, or trailers that don't form a valid skip, so the
decision its merge should carry is fixed first.
"""

import argparse
from collections import Counter
import os
import re
import subprocess
import sys

DECISION_LINE = re.compile(r"(news-deploy(?:-reason)?)[ \t]*:", re.IGNORECASE)
UNREAD = "Commit {} has News-Deploy lines that Git doesn't read as trailers"
INVALID = "Commit {} has News-Deploy trailers that don't form a valid skip: {}"


def annotate(level, message):
    """Print to stderr, and under GitHub Actions also on the run's summary page."""
    prefix = f"::{level}::" if os.environ.get("GITHUB_ACTIONS") == "true" else ""
    print(prefix + message, file=sys.stderr)


def read_decision(revision):
    """Return the commit's decision and reason trailers, and whether other decision lines exist."""
    if not re.fullmatch(r"[0-9a-f]{40}", revision):
        raise ValueError("Expected a full commit SHA.")
    message = subprocess.run(
        ["git", "show", "-s", "--format=%B", revision],
        check=True, capture_output=True, text=True,
    ).stdout
    # A commit message holds no patch, so read it as git log's %(trailers) does, past any "---" line.
    trailers = subprocess.run(
        ["git", "interpret-trailers", "--parse", "--no-divider"],
        input=message, check=True, capture_output=True, text=True,
    ).stdout
    decisions, reasons = [], []
    for line in trailers.splitlines():
        key, _, value = line.partition(":")
        if key.lower() == "news-deploy":
            decisions.append(value.strip())
        elif key.lower() == "news-deploy-reason":
            reasons.append(value.strip())
    # Git reads trailers only from a message's last paragraph; count the rest by key.
    written = Counter(
        match.group(1).lower() for line in message.splitlines()
        if (match := DECISION_LINE.match(line))
    )
    unread = written - Counter({"news-deploy": len(decisions), "news-deploy-reason": len(reasons)})
    return decisions, reasons, bool(unread)


def invalid_decision(decisions, reasons):
    """List what keeps the decision trailers from forming a valid skip; none means valid or absent."""
    if not decisions and not reasons:
        return []
    problems = []
    if not decisions:
        problems.append("no News-Deploy")
    elif len(decisions) > 1:
        problems.append(f"{len(decisions)} News-Deploy trailers ({', '.join(decisions)})")
    elif decisions[0].lower() != "skip":
        problems.append(f'News-Deploy is "{decisions[0]}", not skip')
    if not reasons:
        problems.append("no News-Deploy-Reason")
    elif len(reasons) > 1:
        problems.append(f"{len(reasons)} News-Deploy-Reason trailers")
    elif not reasons[0]:
        problems.append("an empty News-Deploy-Reason")
    return problems


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("event")
    parser.add_argument("ref")
    parser.add_argument("revision")
    args = parser.parse_args()
    deploy = args.ref == "refs/heads/main" and args.event in {"push", "workflow_dispatch"}
    commit = args.revision[:7]
    if args.event == "pull_request":
        decisions, reasons, unread = read_decision(args.revision)
        errors = []
        if unread:
            errors.append(
                UNREAD.format(commit) + ". Git reads trailers only from a message's "
                "last paragraph, so keep News-Deploy and News-Deploy-Reason there with "
                "Co-Authored-By and any other trailers, with no blank line between them."
            )
        if problems := invalid_decision(decisions, reasons):
            errors.append(
                INVALID.format(commit, "; ".join(problems)) + ". A skip needs exactly one "
                "News-Deploy: skip and one non-empty News-Deploy-Reason; to deploy, remove both."
            )
        if errors:
            raise ValueError(" ".join(errors))
    elif deploy and args.event == "push":
        decisions, reasons, unread = read_decision(args.revision)
        problems = invalid_decision(decisions, reasons)
        if decisions and not problems:
            deploy = False
            print("Skipping deployment: " + reasons[0], file=sys.stderr)
        else:
            if unread:
                annotate("warning", UNREAD.format(commit) + ", so this push deploys by default.")
            if problems:
                annotate(
                    "warning",
                    INVALID.format(commit, "; ".join(problems)) + ", so this push deploys by default.",
                )
    print("deploy=" + str(deploy).lower())


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        annotate("error", str(error))
        sys.exit(1)
